# Clave del proveedor de IA (Google AI Studio / Gemini). No la subas al repositorio.
AI_API_KEY=

# Modelo generativo. Debe estar habilitado para la clave anterior.
AI_MODEL=gemini-2.5-flash

# URL pública del sitio, sin barra final. La usan metadatos, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
